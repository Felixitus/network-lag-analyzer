# Runs on the Pi: always LF line endings, even when checked out on Windows.
# An install.sh with CRLF fails with "/usr/bin/env: 'bash\r'", a systemd
# unit with CRLF is silently misread.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.ico  binary
*.pcap binary
*.pcapng binary
*.sqlite3 binary

# Vendored, do not diff
frontend/vendor/** -diff linguist-vendored
